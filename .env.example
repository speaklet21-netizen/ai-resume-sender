# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Production App URL
APP_URL="https://ai-resume-sender.onrender.com"

# Google Cloud OAuth 2.0 Credentials (Multi-user Gmail sending)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://ai-resume-sender.onrender.com/api/auth/google/callback"

# Dedicated AES-256-GCM Token Encryption Key (64 hex characters / 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY="your-64-character-hex-encryption-key"

# Session Signing & OAuth State Secrets (Independent cryptographic keys)
SESSION_SECRET="your-64-character-hex-session-secret"
OAUTH_STATE_SECRET="your-64-character-hex-oauth-state-secret"

# PostgreSQL Database Connection URL (e.g. Neon, Supabase, Render PostgreSQL)
# Required in production for persistent multi-instance sessions, tokens, and resumes
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# OPTIONAL: SMTP Configuration for fallback and OTP verification emails
# Generate an App Password from https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
